# Hosted Supabase. When both values are set, the app uses Supabase Auth.
# Leave them blank for local PostgreSQL during development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL and the shorter QR print domain (same Vercel project).
# NEXT_PUBLIC_APP_URL=https://loyalty.iagodigital.com
# NEXT_PUBLIC_QR_ORIGIN=https://qr.iagodigital.com

# Local development only. Ignored when the Supabase URL and anon key are set.
# A hosted database uses DATABASE_URL (or Vercel Neon POSTGRES_URL). It still needs SESSION_SECRET.
LOCAL_DATABASE_URL=postgres://iago_app:iago_local_dev_only@127.0.0.1:5432/iago_loyalty
LOCAL_DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5432/iago_loyalty
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# POSTGRES_URL=                 # Vercel Neon also works
# POSTGRES_URL_NON_POOLING=     # preferred for migrations
SESSION_SECRET=replace-with-at-least-32-random-characters
SETUP_TOKEN=replace-with-a-random-setup-token
